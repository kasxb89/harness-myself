{
  "name": "@deepseek-ai/dsh-client-ui-prompt-assist",
  "description": "Shared AI prompt writing and iterative revision for creation workspaces",
  "version": "0.2.1-alpha.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~" },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"]
}
