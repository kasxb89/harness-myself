                "type": "string",
              },
              "type": "array",
            },
            "dialogue": {
              "type": "string",
            },
            "duration_seconds": {
              "type": "number",
            },
            "id": {
              "type": "string",
            },
            "order": {
              "type": "number",
            },
            "prompt": {
              "type": "string",
            },
            "scene": {
              "type": "string",
            },
            "subtitles": {
              "type": "string",
            },
            "title": {
              "type": "string",
            },
          },
          "required": [
