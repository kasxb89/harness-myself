              "type": "string",
            },
            "id": {
              "type": "string",
            },
            "name": {
              "type": "string",
            },
            "personality": {
              "type": "string",
            },
            "reference_asset_ids": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "voice": {
              "type": "string",
            },
          },
          "required": [
            "id",
            "name",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "kind": {
        "enum": [
          "image",
          "video",
        ],
        "type": "string",
      },
      "plan_id": {
        "description": "Explicit existing plan id when revising; omit to create.",
        "type": "string",
      },
      "shots": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
            },
            "asset_ids": {
              "items": {
