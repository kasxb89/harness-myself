exports[`deployed Harness API through the real product Loader > requires login for image model discovery and unregisters its visible schema when unloaded > image catalog tool schema 1`] = `
{
  "description": "Read the signed-in account’s available image models and current Host-validated generation controls without submitting images or charging for generation. Read when an exact image model, size, aspect ratio, resolution, count or reference-image limit is needed. Use exact ids and the size strings as returned, including aspect-ratio strings; resolution is a separate field. Empty menus and omitted fields offer no optional choice. Unverified model limits are conservative local limits, not confirmed upstream capabilities. Only pass controls declared by generate_image; this catalog also describes controls available to AI Creation. Listing does not reserve capacity, estimate prices or authorize a generation.",
  "name": "list_image_models",
  "parameters": {
    "properties": {},
    "type": "object",
  },
}
`;

exports[`deployed Harness API through the real product Loader > retains accepted image identity after local cancellation and resumes through panel using GET only > GET-only retained image query tool 1`] = `
{
  "description": "Without operation_id, list unresolved image invocations owned by this account and chat (optionally filter by plan_id) to recover original ids after interruption or restart. With both original plan_id and operation_id, query that accepted task and save completed outputs. This only reads retained tasks; it never submits another generation or accepts a caller-supplied remote URL or task id. If the original submission has no task id, retain its unknown outcome and reconcile the original request instead of generating again. For failed operations, give users only a safe Simplified Chinese summary based on the observed failure category; connection failures and timeouts do not establish whether the cause is local, network, platform or upstream. Distinguish confirmed request or media validation, permission, rate limiting, service HTTP 5xx and upstream task failures; unknown causes remain unconfirmed; never repeat raw HTTP responses, diagnostic JSON, error codes, stacks, internal paths or credentials. Keep actionable guidance for confirmed sign-in, product-credit, file-validation and cancellation failures. When submission or billing outcome is unknown, check existing tasks and artifacts first; do not immediately retry or automatically resubmit. Preserve real tool results. This restriction does not prevent software or code diagnostics explicitly requested by the user.",
  "name": "query_image_task",
  "parameters": {
    "properties": {
      "operation_id": {
        "description": "Original generation operation id. Omit to list unresolved receipts without starting queries.",
        "type": "string",
      },
      "plan_id": {
        "description": "Original retained creation plan id; required when querying one operation.",
        "type": "string",
      },
    },
    "type": "object",
  },
}
`;

