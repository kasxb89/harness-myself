// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`deployed Harness API through the real product Loader > edits current-chat uploaded images and workspace images through the documented multipart endpoint > chat image reference tool 1`] = `
{
  "description": "Generate images or edit reference images through the signed-in account relay, save every result into the artifacts directory, and return the paths. For pending or unknown results, never resubmit this tool: use query_image_task with the original plan_id and operation_id when a task_id was received. Without a task_id, retain the unknown outcome and reconcile the original request before any paid retry. For image-to-image requests, pass the current-chat user attachment or an authorized workspace image in reference_images. Which image models exist, and what each one accepts, is the deployment’s own answer: ask for a model only when the user names one. For Yunshu platform, relay or upstream failures, give users only a safe Simplified Chinese summary such as “服务器繁忙，请稍后重试”; never repeat raw HTTP responses, diagnostic JSON, error codes, stacks, internal paths or credentials. Keep actionable guidance for confirmed sign-in, product-credit, file-validation and cancellation failures. When submission or billing outcome is unknown, check existing tasks and artifacts first; do not immediately retry or automatically resubmit. Preserve real tool results. This restriction does not prevent software or code diagnostics explicitly requested by the user.",
  "name": "generate_image",
  "parameters": {
    "properties": {
      "asset_id": {
        "description": "Exact image asset id in plan_id, including a video plan. Mutually exclusive with shot_id. Creates or reconstructs this source asset, not a finished shot.",
        "type": "string",
      },
      "count": {
        "description": "How many images to render, within the model’s limit (usually 1–4).",
        "type": "number",
      },
      "model": {
        "description": "Optional image model id such as gpt-image-2. Defaults to the first image model the deployment serves for this account.",
        "type": "string",
      },
      "plan_id": {
        "description": "Explicit update_creation_plan id for this generation. Also provide exactly one of shot_id or asset_id.",
        "type": "string",
      },
      "prompt": {
        "description": "What the image should show.",
        "type": "string",
      },
      "reference_images": {
        "description": "Reference images for editing: current-chat user image attachment ids or their exact read-only paths, readable PNG/JPEG/WebP files inside the current workspace, uploaded ma_ ids, or real generated image output ids/paths owned by the same explicit plan_id. Other-chat attachments, unrelated local paths and URLs are refused.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "resolution": {
        "description": "Optional named output tier, only when declared by the chosen model. yunshu-internal-gpt-image-2 accepts 1k, 2k or 4k and defaults to 1k; this is independent from pixel size.",
        "type": "string",
      },
      "shot_id": {
        "description": "Exact shot id in the explicit plan; never guess a latest project.",
        "type": "string",
      },
      "size": {
        "description": "Optional output size such as 1024x1024 or auto. A value the chosen model does not support is refused with that model’s own menu. For yunshu-internal-gpt-image-2, omit pixel size; the server controls output settings.",
        "type": "string",
      },
    },
    "required": [
      "prompt",
    ],
    "type": "object",
  },
}
`;

