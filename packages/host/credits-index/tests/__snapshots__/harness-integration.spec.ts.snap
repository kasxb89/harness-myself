              "type": "string",
            },
            "role": {
              "type": "string",
            },
            "source_path_or_asset_id": {
              "description": "Existing real path or uploaded asset id; use an empty string for an asset that has not been generated. Never invent a path.",
              "type": "string",
            },
          },
          "required": [
            "id",
            "name",
            "kind",
            "source_path_or_asset_id",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "brief": {
        "type": "string",
      },
      "characters": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "appearance": {
              "type": "string",
            },
