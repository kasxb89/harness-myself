exports[`deployed Harness API through the real product Loader > exposes safe platform-failure narration and unknown-outcome recovery on both native media tools > generate_video 1`] = `"Compatibility single-clip generation through the account relay. Read list_video_models first. Prefer generate_video_project for new video requests, including a single clip: its background job exposes queue and generation progress without holding chat open. Do not write submission, polling or download scripts or probe invalid paid durations. For story direction, character/reference continuity, dialogue or subtitles, use the yunshu-video-director skill. For a complete video such as 40 seconds or automatic assembly, always use generate_video_project; several camera beats may fit one clip. Accepted work that outlasts this foreground wait returns pending: query_video_task reads its original receipt, never generate again. Edit existing clips with edit_video. Only declared duration, resolution, ratio, frames and references are accepted. For Yunshu platform, relay or upstream failures, give users only a safe Simplified Chinese summary such as “服务器繁忙，请稍后重试”; never repeat raw HTTP responses, diagnostic JSON, error codes, stacks, internal paths or credentials. Keep actionable guidance for confirmed sign-in, product-credit, file-validation and cancellation failures. When submission or billing outcome is unknown, check existing tasks and artifacts first; do not immediately retry or automatically resubmit. Preserve real tool results. This restriction does not prevent software or code diagnostics explicitly requested by the user."`;

exports[`deployed Harness API through the real product Loader > publishes chat plans and real image outputs through authenticated account/chat media routes > structured creation plan tool 1`] = `
{
  "description": "Create or explicitly revise the structured plan for a chat image or video: stable characters and their appearance, source materials, ordered shots, camera, actions, exact dialogue and subtitles. Use the returned plan_id and the exact shot ids in generate_image/generate_video or shot_ids in generate_video_project. Never associate a generation with a guessed latest project. Planning does not generate media or spend credits. Character/material descriptions and dialogue are requirements, not verified generation results. Preserve user wording and silent/nonverbal requests. Revisions supply the complete plan and cannot remove shots with existing generation records.",
  "name": "update_creation_plan",
  "parameters": {
    "properties": {
      "assets": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
            },
            "id": {
              "type": "string",
            },
            "kind": {
              "enum": [
                "image",
                "video",
                "audio",
                "document",
                "other",
              ],
              "type": "string",
            },
            "name": {
              "type": "string",
            },
            "role": {
              "type": "string",
            },
            "source_path_or_asset_id": {
              "description": "Existing real path or uploaded asset id; use an empty string for an asset that has not been generated. Never invent a path.",
              "type": "string",
            },
          },
          "required": [
            "id",
            "name",
            "kind",
            "source_path_or_asset_id",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "brief": {
        "type": "string",
      },
      "characters": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "appearance": {
              "type": "string",
            },
            "clothing": {
              "type": "string",
            },
            "id": {
              "type": "string",
            },
            "name": {
              "type": "string",
            },
            "personality": {
              "type": "string",
            },
            "reference_asset_ids": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "voice": {
              "type": "string",
            },
          },
          "required": [
            "id",
            "name",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "kind": {
        "enum": [
          "image",
          "video",
        ],
        "type": "string",
      },
      "plan_id": {
        "description": "Explicit existing plan id when revising; omit to create.",
        "type": "string",
      },
      "shots": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
            },
            "asset_ids": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "camera": {
              "type": "string",
            },
            "character_ids": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "dialogue": {
              "type": "string",
            },
            "duration_seconds": {
              "type": "number",
            },
            "id": {
              "type": "string",
            },
            "order": {
              "type": "number",
            },
            "prompt": {
              "type": "string",
            },
            "scene": {
              "type": "string",
            },
            "subtitles": {
              "type": "string",
            },
            "title": {
              "type": "string",
            },
          },
          "required": [
            "id",
            "order",
            "title",
            "prompt",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "style": {
        "type": "string",
      },
      "title": {
        "type": "string",
      },
    },
    "required": [
      "kind",
      "title",
      "brief",
      "shots",
    ],
    "type": "object",
  },
}
`;

exports[`deployed Harness API through the real product Loader > retains accepted image identity after local cancellation and resumes through panel using GET only > GET-only retained image query tool 1`] = `
{
  "description": "Without operation_id, list unresolved image invocations owned by this account and chat (optionally filter by plan_id) to recover original ids after interruption or restart. With both original plan_id and operation_id, query that accepted task and save completed outputs. This only reads retained tasks; it never submits another generation or accepts a caller-supplied remote URL or task id. If the original submission has no task id, retain its unknown outcome and reconcile the original request instead of generating again. For Yunshu platform, relay or upstream failures, give users only a safe Simplified Chinese summary such as “服务器繁忙，请稍后重试”; never repeat raw HTTP responses, diagnostic JSON, error codes, stacks, internal paths or credentials. Keep actionable guidance for confirmed sign-in, product-credit, file-validation and cancellation failures. When submission or billing outcome is unknown, check existing tasks and artifacts first; do not immediately retry or automatically resubmit. Preserve real tool results. This restriction does not prevent software or code diagnostics explicitly requested by the user.",
  "name": "query_image_task",
  "parameters": {
    "properties": {
      "operation_id": {
        "description": "Original generation operation id. Omit to list unresolved receipts without starting queries.",
        "type": "string",
      },
      "plan_id": {
        "description": "Original retained creation plan id; required when querying one operation.",
        "type": "string",
      },
    },
    "type": "object",
  },
}
`;

