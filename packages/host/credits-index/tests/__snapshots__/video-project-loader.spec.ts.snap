exports[`video tools through Loader, real tool registry and jobs runtime > reads a complete structured plan for safe revisions and refuses another chat or an invalid id without generation > read-only creation plan tool 1`] = `
{
  "description": "Read the complete structured plan owned by this account, chat and workspace before revising it. Returns the exact planning fields accepted by update_creation_plan, including stable character, asset and shot ids. Preserve all unrelated entries when updating. This read neither generates media, resumes tasks nor spends credits; it excludes provider requests and credentials.",
  "name": "get_creation_plan",
  "parameters": {
    "properties": {
      "plan_id": {
        "description": "Explicit existing creation plan id.",
        "type": "string",
      },
    },
    "required": [
      "plan_id",
    ],
    "type": "object",
  },
}
`;

exports[`video tools through Loader, real tool registry and jobs runtime > registers the same production tool schemas from the shipped credits apply path > single-clip audio and dialogue contract 1`] = `
{
  "description": "Compatibility single-clip generation through the account relay. Read list_video_models first. Prefer generate_video_project for new video requests, including a single clip: its background job exposes queue and generation progress without holding chat open. Default to one finished work. For several user-requested works, first prepare_video_works with their concrete count and pass a separate returned work_id for each work. Reuse work_id when confirming, correcting or retrying the same finished work: even a new tool-call id returns its original operation instead of another generation POST. A separate actual human request can prepare independent work even with the same brief or plan, while the original accepted or unknown work retains its own task. Natural-language intent and inferred total counts do not gate execution. Progress checks and continuing the original task use its existing query or resume tools. Do not write submission, polling or download scripts or probe invalid paid durations. For story direction, character/reference continuity, dialogue or subtitles, use the yunshu-video-director skill. For a complete video such as 40 seconds or automatic assembly, always use generate_video_project; several camera beats may fit one clip. Accepted work that outlasts this foreground wait returns pending: query_video_task reads its original receipt without repeating that submission. Edit existing clips with edit_video. Only declared duration, resolution, ratio, frames and references are accepted.结合完整对话理解创作意图，不要求用户使用固定句式或反复重述数量。未指定数量默认一条；用户明确需要几条成片，就先用 prepare_video_works 准备对应数量，再逐个使用返回的 work_id 生成。单条简单请求可以直接生成，Host 自动准备一个默认作品编号。作品编号用于同一成片的防重复，不是从用户措辞推算的权限额度。普通确认、修改参数和继续同一作品时复用已有 work_id；尚未提交时可以纠正参数，已提交或结果未知时只查询、恢复原任务，不通过换工具调用或重新准备编号再生成。台词、字幕和故事里的疑问或否定不代表取消。准备同一请求会返回原作品清单，不增加版本；若已准备清单后，用户在真实问题回答中明确增加数量，先核对已有清单，再用 append_video_works 追加缺少的条数（已有一条改为总共三条时追加两条），保留原 work_id 和未知任务。同一回答重复追加不会再次加片，不能把普通确认、查询或重试当作追加指令。非 H3 报价选择只批准当前一件作品，追加作品分别核对实际报价；用户另行发起独立新请求时可以准备新的清单，即使提示词或计划相同，也不受旧任务等待或未知影响。清单中的待办不是必须执行的订单；用户减少数量时只启动其仍要求的作品，未启动的多余编号可以保留，不能为了清空清单生成。不要为了填满并发、质量评价或修改计划自动增加收费作品。是否另做仍不明确时只简短确认，不把正常对话说成平台拒绝。 For failed operations, give users only a safe Simplified Chinese summary based on the observed failure category; connection failures and timeouts do not establish whether the cause is local, network, platform or upstream. Distinguish confirmed request or media validation, permission, rate limiting, service HTTP 5xx and upstream task failures; unknown causes remain unconfirmed; never repeat raw HTTP responses, diagnostic JSON, error codes, stacks, internal paths or credentials. Keep actionable guidance for confirmed sign-in, product-credit, file-validation and cancellation failures. When submission or billing outcome is unknown, check existing tasks and artifacts first; do not immediately retry or automatically resubmit. Preserve real tool results. This restriction does not prevent software or code diagnostics explicitly requested by the user.",
  "name": "generate_video",
  "parameters": {
    "properties": {
      "audio": {
        "description": "Optional requested audio state. Sent as a switch only when the chosen model declares one; fixed native audio accepts only its declared state. An audio stream does not verify dialogue, lip-sync or subtitles.",
        "type": "boolean",
      },
      "duration_seconds": {
        "description": "Clip length in seconds; only values the chosen model declares are accepted.",
        "type": "number",
      },
      "frame_images": {
        "description": "Optional stored ids (ma_…) used as first/last frame.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "model": {
        "description": "Defaults to MiniMax-H3 at 768P unless the human explicitly requested another resolution. A non-H3 model requires a current full-price estimate and a real human model selection before generation; model arguments never approve that change.",
        "type": "string",
      },
      "plan_id": {
        "description": "Explicit update_creation_plan id for this generation. Also provide shot_id.",
        "type": "string",
      },
      "prompt": {
        "description": "What the video should show. Before calling, script user-delegated narrative or dialogue scenes with stable character ids, language, brief exact lines and their timing, identifying on-screen speakers versus narration; preserve user-supplied wording. Do not reduce a story requiring voices to a music montage. Respect silent/no-dialogue requests and do not add dialogue or subtitles to unrelated nonverbal videos. Include requested lip-sync and subtitle requirements. These request native model generation, not separate speech, lip-sync or subtitle processing; verify the rendered result before claiming they are met.",
        "type": "string",
      },
      "ratio": {
        "description": "Aspect ratio such as 16:9 or 9:16; adaptive inherits it from the reference media.",
        "type": "string",
      },
      "reference_audios": {
        "description": "Optional uploaded ma_ audio ids or workspace WAV/MP3 paths, when the model supports audio references. First copy a user-supplied, read-authorized chat attachment outside the workspace into the workspace using existing file tools; do not copy unrelated files. References do not guarantee copied speech, matching mouth movements or subtitles.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "reference_images": {
        "description": "Optional stored ids (ma_…) used as multimodal subject/style references, when the model supports them.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "reference_videos": {
        "description": "Optional uploaded ma_ ids or readable workspace MP4/MOV paths, only when the exact model supports reference videos. First copy a current user-supplied, read-authorized chat attachment outside the workspace into the workspace using existing file tools. Do not copy unrelated files or attachments from other chats. Direct external paths, URLs and attachment ids are not accepted.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "resolution": {
        "description": "Output resolution such as 768P or 2K, when the model offers choices.",
        "type": "string",
      },
      "shot_id": {
        "description": "Exact shot id in the explicit plan; never guess a latest project.",
        "type": "string",
      },
      "work_id": {
        "description": "Existing work_id from prepare_video_works or an earlier generation result. Reuse it for the same finished work across tool calls and confirmations. Omission selects the current request’s first default work; it never creates another version of that work. For several works, prepare the complete count first and use each returned work_id once.",
        "type": "string",
      },
    },
    "required": [
      "prompt",
    ],
    "type": "object",
  },
}
`;

