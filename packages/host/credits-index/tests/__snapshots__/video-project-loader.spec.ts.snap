          "description": "Exact model-supported whole seconds per clip, in shot_ids or shot_prompts order. Their sum must equal total_duration_seconds. When omitted for an explicit creation plan, use its saved shot durations; do not silently change timeline timing.",
          "items": {
            "type": "number",
          },
          "type": "array",
        },
        "shot_ids": {
