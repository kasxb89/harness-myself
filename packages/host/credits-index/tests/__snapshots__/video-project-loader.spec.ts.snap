          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "reference_images": {
          "description": "Existing uploaded ma_ subject/style image ids or workspace image paths. For a user-supplied chat attachment outside the workspace, first copy the read-authorized attachment into the workspace with existing file tools and pass its copied path.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "reference_videos": {
          "description": "Existing uploaded ma_ video reference ids or workspace video paths. For a user-supplied chat attachment outside the workspace, first copy the read-authorized attachment into the workspace with existing file tools and pass its copied path.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "resolution": {
          "type": "string",
        },
        "shot_ids": {
          "description": "Exact shot ids belonging to plan_id, one per actual supported model clip and in generation order.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "shot_prompts": {
          "description": "Exact shot briefs, one per planned clip. For delegated narrative or dialogue, first write a short script and allocate each shot its character ids, language, exact lines and timing, distinguishing on-screen speech from narration; preserve user-provided wording. Keep each shot focused on its assigned lines rather than repeating the whole story. Respect silent/no-dialogue requests. Omit for briefs that do not require shot-specific scripting.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "total_duration_seconds": {
          "description": "Desired final length in whole seconds; this may exceed the model single-clip limit.",
          "type": "number",
        },
      },
      "required": [
        "prompt",
        "total_duration_seconds",
      ],
      "type": "object",
    },
  },
  {
    "description": "Read a durable video project owned by this account, workspace, and chat. This does not restart generation or spend credits. After an app restart, an interrupted project is a saved record, not a live job. Inspect clip_paths and task_ids before explicitly resuming.",
    "name": "video_project_status",
    "parameters": {
