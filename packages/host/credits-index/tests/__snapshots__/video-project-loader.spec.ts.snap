exports[`video tools through Loader, real tool registry and jobs runtime > registers the same production tool schemas from the shipped credits apply path > single-clip audio and dialogue contract 1`] = `
{
  "description": "Generate, poll and save one short video clip through the account relay. Call this native tool directly for a simple short-video brief; do not write submission, polling or download scripts. For story direction, character/reference continuity, dialogue or subtitles, use the yunshu-video-director skill. For a complete video such as 40 seconds or automatic assembly, use generate_video_project instead; several camera beats may fit one clip. Edit existing clips with edit_video. This single-clip tool accepts only the chosen model’s declared duration, resolution, ratio, frames and references.",
  "name": "generate_video",
  "parameters": {
    "properties": {
      "audio": {
        "description": "Optional requested audio state. Sent as a switch only when the chosen model declares one; fixed native audio accepts only its declared state. An audio stream does not verify dialogue, lip-sync or subtitles.",
        "type": "boolean",
      },
      "duration_seconds": {
        "description": "Clip length in seconds; only values the chosen model declares are accepted.",
        "type": "number",
      },
      "frame_images": {
        "description": "Optional stored ids (ma_…) used as first/last frame.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "model": {
        "description": "Optional video model id such as MiniMax-H3. Defaults to the first video model the deployment serves for this account.",
        "type": "string",
      },
      "plan_id": {
        "description": "Explicit update_creation_plan id for this generation. Also provide shot_id.",
        "type": "string",
      },
      "prompt": {
        "description": "What the video should show. Before calling, script user-delegated narrative or dialogue scenes with stable character ids, language, brief exact lines and their timing, identifying on-screen speakers versus narration; preserve user-supplied wording. Do not reduce a story requiring voices to a music montage. Respect silent/no-dialogue requests and do not add dialogue or subtitles to unrelated nonverbal videos. Include requested lip-sync and subtitle requirements. These request native model generation, not separate speech, lip-sync or subtitle processing; verify the rendered result before claiming they are met.",
        "type": "string",
      },
      "ratio": {
        "description": "Aspect ratio such as 16:9 or 9:16; adaptive inherits it from the reference media.",
        "type": "string",
      },
      "reference_audios": {
        "description": "Optional uploaded ma_ audio ids or workspace WAV/MP3 paths, when the model supports audio references. First copy a user-supplied, read-authorized chat attachment outside the workspace into the workspace using existing file tools; do not copy unrelated files. References do not guarantee copied speech, matching mouth movements or subtitles.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "reference_images": {
        "description": "Optional stored ids (ma_…) used as multimodal subject/style references, when the model supports them.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "reference_videos": {
        "description": "Optional stored ids (ma_…) used as a reference video, when the model supports video-to-video.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "resolution": {
        "description": "Output resolution such as 768P or 2K, when the model offers choices.",
        "type": "string",
      },
      "shot_id": {
        "description": "Exact shot id in the explicit plan; never guess a latest project.",
        "type": "string",
      },
    },
    "required": [
      "prompt",
    ],
    "type": "object",
  },
}
`;

exports[`video tools through Loader, real tool registry and jobs runtime > registers the same production tool schemas from the shipped credits apply path 1`] = `
[
  {
    "description": "Create a finished video longer than one model clip from a natural-language brief. Use the yunshu-video-director skill for story, character/reference continuity, dialogue and subtitles, then call this native workflow; do not write polling, download or assembly scripts. For requests such as a 40-second video, plan the fewest supported clips (for a 15-second limit: 15+15+10, or three 15-second clips trimmed to 40), generate them in order using the signed-in account, then automatically normalize, trim, and join them locally. All local tools and every request are checked before billing. Returns a background job_id and durable project_id; read job_output for progress and call present on the completed final_path. Never claim completion before the job reports a saved final_path. Already submitted provider tasks may continue billing after local cancellation. If a current user-supplied chat attachment is outside the workspace, first copy that read-authorized attachment into this workspace with the existing file tools, then pass the copied path; do not copy unrelated files.",
    "name": "generate_video_project",
    "parameters": {
      "properties": {
        "audio": {
