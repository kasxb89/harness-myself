+/** Normalize the operator's HTTPS URL prefix; invalid configuration fails before routes mount. */
+export function normalizeGithubProxy(value) {
+    if (value === undefined) return undefined;
+    if (typeof value !== 'string' || value === '' || value.length > 2048 || /[\s\x00-\x1f\x7f\\]/u.test(value))
+        throw new TypeError('dsh-skin-market: githubProxy must be an HTTPS URL prefix without credentials, whitespace, query or fragment');
+    let parsed;
+    try { parsed = new URL(value); }
+    catch { throw new TypeError('dsh-skin-market: githubProxy must be an HTTPS URL prefix'); }
+    if (parsed.protocol !== 'https:' || parsed.username !== '' || parsed.password !== '' || parsed.search !== '' || parsed.hash !== '')
+        throw new TypeError('dsh-skin-market: githubProxy must be an HTTPS URL prefix without credentials, query or fragment');
+    return `${parsed.origin}${parsed.pathname.replace(/\/+$/u, '')}`;
+}
+/** Route only GitHub resource hosts and the skin market's fixed generated-media directory. */
+export function githubResourceUrl(url, proxy) {
+    if (proxy === undefined || proxy === null) return url;
+    let target;
+    try { target = new URL(url); }
+    catch { return url; }
+    if (target.protocol !== 'https:' || target.username !== '' || target.password !== '' || target.port !== '') return url;
+    const githubHost = ['github.com', 'raw.githubusercontent.com', 'avatars.githubusercontent.com', 'user-images.githubusercontent.com', 'camo.githubusercontent.com'].includes(target.hostname);
+    const generatedMedia = target.hostname === 'kingofsoysauce.github.io' && target.pathname.startsWith('/dsh-skin-market/skin-media/');
+    return githubHost || generatedMedia ? `${proxy}/${url}` : url;
+}
