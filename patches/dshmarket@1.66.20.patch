+/** Operator-owned HTTPS prefixes, scoped to the market activation that registered them. */
+const configuredGithubProxies: Array<{ value: string }> = []
+/** Validate one operator prefix without changing the process environment. */
+export function validateConfiguredGithubProxy(value: string): string {
+    const normalized = normalizeGithubProxy(value);
+    if (normalized === null || /[\s\x00-\x1f\x7f]/u.test(value) || value.length > 2048)
+        throw new TypeError('dsh-market: githubProxy must be an HTTPS URL prefix without credentials, whitespace, query or fragment');
+    return normalized;
+}
+/** Register an operator prefix; disposing an older activation leaves newer activations unchanged. */
+export function useConfiguredGithubProxy(value: string): () => void {
+    const entry = { value: validateConfiguredGithubProxy(value) };
+    configuredGithubProxies.push(entry);
+    resetGithubRoutePreferences();
+    return () => {
+        const index = configuredGithubProxies.indexOf(entry);
+        if (index === -1) return;
+        configuredGithubProxies.splice(index, 1);
+        resetGithubRoutePreferences();
+    };
+}
+function configuredGithubProxy(): string | null {
+    return configuredGithubProxies.at(-1)?.value ?? null;
+}
